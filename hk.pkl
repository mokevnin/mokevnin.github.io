amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// Fast, offline checks on staged files at commit.
local fast = new Mapping<String, Step> {
    ["rumdl"] = Builtins.rumdl
    ["typos"] = Builtins.typos
    ["betterleaks"] = Builtins.betterleaks
    ["jactionlint"] = Builtins.jactionlint
}

// The files the site is built from.
local site = List("src/**", "astro.config.mjs", "tsconfig.json", "package.json", "package-lock.json")
// lychee reads dist/ plus the Markdown files, so a change to either needs a fresh build.
local linked = site + List("*.md")

// Slower or network-bound: pre-push, `check` and CI.
local all = (fast) {
    ["astro-check"] {
        glob = site
        check = "npx astro check"
    }
    ["build"] {
        glob = linked
        check = "npm run build"
    }
    // Links are checked in the built page, so the ones in src/data and in the layout are covered.
    // Root-relative links resolve against dist/.
    ["lychee"] {
        glob = linked
        depends = "build"
        check = "lychee --config lychee.toml --no-progress --root-dir \"$PWD/dist\" dist README.md AGENTS.md"
    }
    ["osv-scanner"] = Builtins.osv_scanner
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = fast
    }
    ["pre-push"] {
        steps = all
    }
    ["check"] {
        steps = all
    }
    ["fix"] {
        fix = true
        steps = all
    }
}

---
import { type Entry, md } from "../data";

interface Props {
  items: Entry[];
}

const { items } = Astro.props;
---

<ul class="mb-4">
  {
    items.map((item) => (
      <li class="border-b border-line py-2.5 last:border-b-0">
        {item.url ? <a href={item.url}>{item.title}</a> : item.title}
        {item.venue && (
          <>
            {" — "}
            <span class="text-sm text-muted [&_a]:text-muted [&_a]:underline" set:html={md(item.venue)} />
          </>
        )}
      </li>
    ))
  }
</ul>

---
import type { Entry } from "../data";
import ArchiveRow from "./ArchiveRow.astro";

interface Props {
  items: Entry[];
  // How many entries show before the rest fold under "show all"; <details> needs no JavaScript.
  visible?: number;
}

const { items, visible = items.length } = Astro.props;
const shown = items.slice(0, visible);
const folded = items.slice(visible);
---

<ul class="divide-y divide-line border-y border-line">
  {shown.map((item) => <ArchiveRow item={item} />)}
</ul>
{
  folded.length > 0 && (
    <details class="group">
      <summary class="mt-3 inline-flex cursor-pointer list-none items-center gap-2 font-mono text-sm text-accent select-none hover:underline [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Показать все ({items.length})</span>
        <span class="hidden group-open:inline">Свернуть</span>
        <span aria-hidden="true" class="transition group-open:rotate-180">
          ↓
        </span>
      </summary>
      <ul class="mt-3 divide-y divide-line border-y border-line">
        {folded.map((item) => (
          <ArchiveRow item={item} />
        ))}
      </ul>
    </details>
  )
}

---
import type { Milestone } from "../data";

interface Props {
  items: Milestone[];
}

const { items } = Astro.props;
---

<ol class="space-y-6 border-t border-line pt-6">
  {
    items.map((item) => (
      <li class="grid gap-1 sm:grid-cols-[9.5rem_1fr] sm:gap-6">
        <span class="font-mono text-sm text-accent sm:pt-0.5">{item.period}</span>
        <p class="text-[15px]/relaxed">{item.text}</p>
      </li>
    ))
  }
</ol>

---
import type { Link } from "../data";

interface Props {
  items: Link[];
  // The first link is the main one and gets a filled button.
  primaryFirst?: boolean;
}

const { items, primaryFirst = false } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {
    items.map((item, index) => (
      <li>
        <a
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium transition hover:no-underline",
            primaryFirst && index === 0
              ? "bg-accent text-page hover:opacity-90"
              : "border border-line bg-surface text-ink hover:border-accent hover:text-accent",
          ]}
          href={item.url}
        >
          {item.title}
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))
  }
</ul>

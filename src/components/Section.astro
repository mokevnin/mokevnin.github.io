---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section>
  <!-- scroll-mt keeps the heading clear of the sticky section nav after an anchor jump. -->
  <h2 id={id} class="mt-14 mb-4 scroll-mt-[110px] text-[26px] font-bold tracking-[-0.01em]">{title}</h2>
  <slot />
</section>

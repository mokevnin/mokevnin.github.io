---
import { type Card, md } from "../data";

interface Props {
  items: Card[];
  // Smaller cards with monospace names, for the open-source repositories.
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<ul class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <li
        class:list={[
          "rounded-xl border border-line bg-surface transition hover:border-accent hover:shadow-[0_4px_16px_rgb(0_0_0/0.06)]",
          compact ? "px-4 py-3.5 text-sm" : "px-5 py-[18px] text-[15px]/[1.55]",
        ]}
      >
        <strong class:list={[compact ? "font-mono text-[15px]" : "text-[17px]"]}>
          <a href={item.url}>{item.name}</a>
        </strong> — <Fragment set:html={md(item.description)} />
      </li>
    ))
  }
</ul>

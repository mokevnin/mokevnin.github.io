---
import Archive from "../components/Archive.astro";
import LinkButtons from "../components/LinkButtons.astro";
import Profile from "../components/Profile.astro";
import ProjectCards from "../components/ProjectCards.astro";
import RepoList from "../components/RepoList.astro";
import Section from "../components/Section.astro";
import SectionNav from "../components/SectionNav.astro";
import Timeline from "../components/Timeline.astro";
import { data } from "../data";
import Base from "../layouts/Base.astro";
import { site } from "../site";

// The ids match the anchors of the previous site, so links to sections keep working.
const sectionList = [
  { key: "projects", id: "проекты", title: "Проекты" },
  { key: "openSource", id: "open-source", title: "Open Source" },
  { key: "orgprog", id: "организованное-программирование", title: "Организованное программирование" },
  { key: "texts", id: "тексты", title: "Тексты" },
  { key: "talks", id: "выступления", title: "Выступления" },
  { key: "podcasts", id: "вебинары-и-подкасты", title: "Вебинары и подкасты" },
  { key: "career", id: "карьерный-путь", title: "Карьерный путь" },
].map((section, index) => ({ ...section, number: String(index + 1).padStart(2, "0") }));
const sections = Object.fromEntries(sectionList.map(({ key, ...section }) => [key, section]));

// Long lists show this many entries before folding the rest.
const visibleEntries = 8;
---

<Base>
  <div class="mx-auto max-w-6xl px-5 sm:px-8 lg:flex lg:gap-20 lg:px-12">
    <!--
      On wide screens the profile and the section list stay in view. self-start keeps the column
      from stretching to the row's height, which would stop it from sticking.
    -->
    <aside
      class="pt-12 pb-8 lg:sticky lg:top-0 lg:flex lg:max-h-dvh lg:w-80 lg:flex-none lg:flex-col lg:gap-12 lg:self-start lg:overflow-y-auto lg:py-16"
    >
      <Profile />
      <SectionNav sections={sectionList} variant="column" />
    </aside>

    <div class="min-w-0 flex-1 lg:py-16">
      <SectionNav sections={sectionList} variant="bar" />

      <p class="pt-8 text-lg/relaxed text-ink lg:pt-0 lg:text-xl/relaxed">
        Привет, меня зовут Кирилл Мокевнин, разработчик и со-основатель школы программирования Хекслет. Я пишу
        статьи, делаю курсы и выступаю на конференциях. Веду подкаст и телеграм-канал «Организованное
        программирование» про инженерную культуру и практику разработки. Сейчас много занимаюсь агентной
        разработкой: помогаю командам внедрять AI-агентов в процесс разработки и пишу open-source инструменты для
        этого. На этом сайте собрана информация обо мне и всех моих активностях.
      </p>

      <Section {...sections.projects}>
        <ProjectCards items={data.projects} />
      </Section>

      <Section {...sections.openSource}>
        <RepoList items={data.openSource} />
      </Section>

      <Section {...sections.orgprog}>
        <div class="rounded-2xl bg-accent-soft p-6 sm:p-8">
          <p class="mb-5 text-lg/relaxed">Подкаст и телеграм-канал про инженерную культуру и практику разработки.</p>
          <LinkButtons items={data.orgprog} primaryFirst />
        </div>
      </Section>

      <Section {...sections.texts}>
        <LinkButtons items={data.textLinks} />
        <p class="mt-8 mb-3 text-muted">Отдельные статьи и интервью:</p>
        <Archive items={data.articles} />
      </Section>

      <Section {...sections.talks}>
        <p class="mb-3 text-muted">Конференции и митапы, от новых к старым.</p>
        <Archive items={data.talks} visible={visibleEntries} />
      </Section>

      <Section {...sections.podcasts}>
        <Archive items={data.podcasts} visible={visibleEntries} />
      </Section>

      <Section {...sections.career}>
        <p class="mb-8 text-[15px]/relaxed text-muted">
          В коммерческой разработке я с 2007 года. Основной фокус — веб-разработка во всём её спектре: от бэкенда и
          фронтенда до инфраструктуры и процессов (DevOps, CI/CD, организация командной работы). Прошел путь от
          разработчика, тимлида и СТО до VP of Engineering. Со временем всё больше внимания уделяю не только
          написанию кода, но и обучению разработчиков и формированию инженерной культуры. С 2015 года полностью
          переключился на Хекслет и продолжаю заниматься примерно тем же, но уже работая на себя.
        </p>
        <Timeline items={data.career} />
      </Section>

      <footer class="mt-24 flex flex-wrap justify-between gap-2 border-t border-line py-8 font-mono text-xs text-muted">
        <span>{site.name} — ссылки на статьи, видео и другое</span>
        <span>Astro + Tailwind CSS</span>
      </footer>
    </div>
  </div>
</Base>
